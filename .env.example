# CytoZoe configuration. No secrets or API keys are required.
# Absolute, writable folder for the local SQLite database (reviews, imported data). Default: <repo>/runtime
CYTOZOE_DATA_DIR=
# Host names accepted by the loopback server (comma-separated). Do not add 0.0.0.0 or public names.
CYTOZOE_ALLOWED_HOSTS=127.0.0.1,localhost
# Optional: override the build identifier shown in exports (default: git short hash).
CYTOZOE_GIT_VERSION=
